# Django Core
DJANGO_SECRET_KEY=change-me-to-a-very-long-and-secure-random-secret-key-32-chars-min
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.development

# Database (PostgreSQL)
DATABASE_URL=postgres://omni_user:omni_password@localhost:5432/omni_db
DB_NAME=omni_db
DB_USER=omni_user
DB_PASSWORD=omni_password
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT Authentication
JWT_SECRET_KEY=change-me-to-a-jwt-signing-secret-key-that-is-independent-of-django
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:8000

# Sentry & Observability
SENTRY_DSN=
ENVIRONMENT=development

# Object Storage (S3 / MinIO)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
